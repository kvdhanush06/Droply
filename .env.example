# Droply backend configuration
# Copy to .env (or set in your environment) and adjust. Never commit real secrets.

# Port the server listens on.
PORT=3000

# Bind address. Use 0.0.0.0 to listen on all interfaces (required in Docker,
# and needed for phones on the same hotspot to connect). Use 127.0.0.1 to
# restrict the server to this machine only.
HOST=0.0.0.0

# Comma-separated list of extra allowed WebSocket origins.
# Same-origin requests are always allowed. In non-production mode, localhost
# origins are allowed automatically for local development.
# Example: ALLOWED_ORIGINS=https://droply.example.com,https://www.droply.example.com
ALLOWED_ORIGINS=

# How long an idle room stays alive before it is expired (seconds).
ROOM_TTL_SECONDS=1800

# Maximum number of devices that may join one room.
MAX_ROOM_PEERS=4

# Maximum concurrent rooms held in memory.
MAX_ROOMS=10000

# Maximum concurrent WebSocket connections.
MAX_CONNECTIONS=500

# Maximum size (bytes) of a single signaling message.
MAX_WS_MESSAGE_BYTES=65536

# Per-IP rate limits.
RATE_LIMIT_CONNECTIONS_PER_MINUTE=120
RATE_LIMIT_ROOM_CREATES_PER_MINUTE=30
RATE_LIMIT_ROOM_JOINS_PER_MINUTE=60
RATE_LIMIT_MESSAGES_PER_SECOND=30

# Comma-separated STUN server URLs. Defaults to a public STUN server.
STUN_SERVERS=stun:stun.l.google.com:19302

# Optional TURN relay (used only when direct connectivity fails).
# TURN credentials are delivered to browsers by design; use short-lived,
# scoped credentials from your TURN provider. Never hard-code them in source.
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=

# Directory that contains the built frontend (index.html, assets/...).
# Defaults to ../frontend/dist relative to the backend package.
STATIC_DIR=

# Set to "true" when running behind a reverse proxy that sets X-Forwarded-For,
# so rate limiting sees the real client IP.
TRUST_PROXY=false

# Node environment: development | production | test
NODE_ENV=development
